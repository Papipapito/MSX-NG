digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.28", ranksep="0.5", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#334155", fillcolor="#f8fafc", width=1.45];
  edge [color="#64748b", penwidth=1.4, arrowsize=0.7];
  m0 [label="M0\nSpec / ABI", fillcolor="#f1f5f9"];
  m1 [label="M1\nClock + DDR", fillcolor="#ecfeff"];
  m2 [label="M2\nRV32 bare metal", fillcolor="#e0f2fe"];
  m3 [label="M3\nOpenSBI + Linux", fillcolor="#dbeafe"];
  m4 [label="M4\nHDMI + DRM/KMS", fillcolor="#ede9fe"];
